# Development scanner used for hardware probes and integration tests.
# Copy to config/dev-scanner.env (git-ignored) and fill in your own values.
SCANNER_MODEL=SDS200
SCANNER_HOST=scanner.example.lan
SCANNER_IP=192.0.2.10
SCANNER_UDP_PORT=50536
SCANNER_RTSP_PORT=554
# SCANNER_SERIAL=auto
# (SCANNER_SERIAL is read only with --serial: a port path, or auto to use the one Uniden port found.)
# SCANNER_SERIAL_SDS100=auto
# (SCANNER_SERIAL_SDS100 is read only by the SDS100 hardware tests: its port path, or auto for the one port named SDS100.)
# SCANNER_SERIAL_BCD436HP=auto
# (SCANNER_SERIAL_BCD436HP is read only by the BCD436HP hardware tests: its port path, or auto for the one port named BCD436HP.)
